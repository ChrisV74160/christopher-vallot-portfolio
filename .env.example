# Clé privée créée depuis le tableau de bord Resend.
RESEND_API_KEY=re_xxxxxxxxx

# Adresse qui reçoit les demandes du portfolio.
CONTACT_EMAIL=contact@example.com

# Facultatif en développement, recommandé en production : utilisez un domaine
# d’envoi vérifié dans Resend.
CONTACT_FROM_EMAIL="Portfolio Christopher Vallot <contact@example.com>"

# URL publique canonique utilisée par les métadonnées, le sitemap et robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Garde l’indexation désactivée hors du domaine public. Utiliser "production"
# uniquement pour la mise en ligne finale, jamais pour une preview.
SITE_ENV=preview
