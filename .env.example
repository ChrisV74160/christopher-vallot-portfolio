# Clé privée créée depuis le tableau de bord Resend.
# Sur Netlify : variable secrète, scope Functions, contexte Production.
# Laisser vide pour tester localement sans envoi de message.
RESEND_API_KEY=

# Adresse qui reçoit les demandes du portfolio.
# Sur Netlify : scope Functions, contexte Production.
CONTACT_EMAIL=

# Facultatif : utilisez en production un domaine
# d’envoi vérifié dans Resend. Sur Netlify : scope Functions, Production.
CONTACT_FROM_EMAIL=

# URL publique canonique utilisée par les métadonnées, le sitemap et robots.txt.
# Sur Netlify, utilisez d’abord l’URL principale en .netlify.app, puis le domaine
# personnalisé après son raccordement. N’utilisez jamais une URL de preview.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Garde l’indexation désactivée hors du domaine public. Utiliser "production"
# uniquement dans le contexte Netlify Production et "preview" ailleurs.
SITE_ENV=preview

# Netlify fournit automatiquement SITE_ID aux Functions : ne pas le définir
# localement. Il permet de choisir x-nf-client-connection-ip pour l’antispam.
# Sur un autre hébergement, le proxy doit remplacer x-forwarded-for/x-real-ip
# avant la Function ; ne jamais faire confiance aux valeurs envoyées par le client.
